<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/startCallForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <EditText
            android:id="@+id/startCallUserId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="UserId"
            android:inputType="text"
            android:text="User-A"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#99FFFFFF" />

        <EditText
            android:id="@+id/startCallCallId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Call-Id"
            android:inputType="text"
            android:text="call-123"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#99FFFFFF" />

        <Button
            android:id="@+id/connectCall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Connect" />

        <TextView
            android:id="@+id/callConnectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text=""
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/startCallCameraContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <SurfaceView
            android:id="@+id/vulkanSurface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <SurfaceView
            android:id="@+id/floatingVulkanSurface"
            android:layout_width="144dp"
            android:layout_height="192dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="132dp"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/cameraStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#80000000"
                android:fontFamily="monospace"
                android:padding="8dp"
                android:text="Call camera starting..."
                android:textColor="#FFFFFFFF"
                android:textIsSelectable="true" />

            <Button
                android:id="@+id/flipCamera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Flip Camera" />

            <Button
                android:id="@+id/saveFilteredFrame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Save Filtered YUV Ring" />

            <TextView
                android:id="@+id/callTimerText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#80000000"
                android:fontFamily="monospace"
                android:gravity="center"
                android:padding="8dp"
                android:text="00:00"
                android:textColor="#FFFFFFFF" />

            <Button
                android:id="@+id/disconnectCall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Disconnect" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
